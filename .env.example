APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://api_kurir:api_kurir@localhost:55432/api_kurir?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
# Bootstrap API key ini juga menjadi dedicated service key Main Service Emisell.
# Customer key hasil generate tidak dapat membawa konteks merchant.
API_KEYS=dev-api-key
ADMIN_API_KEYS=dev-emisell
SHUTDOWN_TIMEOUT=10s

# Redis disiapkan, tetapi tidak wajib pada fase MVP.
REDIS_ENABLED=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=api-kurir

# Key RajaOngkir ditambahkan dari Dashboard > Kuota provider.
# Master key ini mengenkripsi seluruh credential provider di database.
# Production wajib mengisinya dengan base64 acak yang decode menjadi 32 byte.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

# Request backend Emisell mengirim merchant melalui X-Emisell-Merchant-ID.
# API key yang dipakai wajib khusus service-to-service dan tidak boleh masuk browser.

# Limit global pilihan checkout per merchant. GET shipping-services mengembalikan
# pemakaian dan sisa limit; PUT menolak pilihan di atas batas ini.
MERCHANT_SHIPPING_MAX_COURIERS=5
MERCHANT_SHIPPING_MAX_SERVICES=20

# RAJAONGKIR_API_KEY hanya fallback legacy; biarkan kosong untuk instalasi baru.
# Shipping Delivery memakai credential capability terpisah. Instalasi baru
# sebaiknya menyimpan kedua key melalui provider credential di dashboard.
RAJAONGKIR_TRACKING_COURIERS=jne,sap,ninja,jnt,tiki,wahana,pos,lion,anteraja
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1/
RAJAONGKIR_TIMEOUT=4s
RAJAONGKIR_DELIVERY_API_KEY=
RAJAONGKIR_DELIVERY_BASE_URL=https://api.collaborator.komerce.id
RAJAONGKIR_DELIVERY_TIMEOUT=8s
RAJAONGKIR_DAILY_LIMIT=50000
RAJAONGKIR_CREDENTIAL_ALIAS=primary
RAJAONGKIR_SNAPSHOT_TTL=336h
RAJAONGKIR_MIN_REQUEST_INTERVAL=250ms
# Runtime API Kurir hanya memanggil connector hosted ini. URL upstream resmi
# tetap menjadi tanggung jawab container connector.
RAJAONGKIR_HOSTED_BASE_URL=http://127.0.0.1:18080/partner/v1
# URL yang ditampilkan di Partner Explorer. Production wajib HTTPS.
RAJAONGKIR_HOSTED_PUBLIC_BASE_URL=https://api-kurir.emisell.com/connectors/rajaongkir/v1
RAJAONGKIR_HOSTED_TIMEOUT=8s
LOCATION_SYNC_REQUEST_INTERVAL=250ms

# Biteship adalah fallback internal Emisell Kurir untuk cek ongkir dan resi.
# RajaOngkir tetap selalu dicoba lebih dahulu. Token disimpan melalui Dashboard
# > Kuota provider, bukan di environment. Integrasi RajaOngkir BYOK seller tidak
# memakai saldo Biteship platform. Kurir instant (Grab/GoSend) tidak diikutkan.
BITESHIP_BASE_URL=https://api.biteship.com/
BITESHIP_TIMEOUT=5s
# Snapshot tarif fallback disimpan terpisah dari snapshot RajaOngkir.
BITESHIP_RATE_FALLBACK_ENABLED=true
BITESHIP_RATE_SNAPSHOT_TTL=336h
# Daftar ini ditambahkan ke coverage RajaOngkir. Kurir yang sama dapat tersedia
# pada keduanya agar Biteship dapat mengambil alih saat jalur utama gagal.
BITESHIP_TRACKING_COURIERS=ide,rpx,sentral,sicepat

# Tracking menyimpan resi terenkripsi. Key wajib base64 yang decode menjadi 32 byte.
TRACKING_ENABLED=false
TRACKING_ENCRYPTION_KEY=
TRACKING_WORKER_ID=worker-local
TRACKING_WORKER_CONCURRENCY=8
TRACKING_POLL_INTERVAL=1s

# Webhook hanya menuju backend Emisell yang dikonfigurasi operator. URL callback
# tidak pernah diterima dari request seller untuk mencegah SSRF.
# Fallback migrasi. Setelah diatur dari menu Developer > Webhook, konfigurasi
# database menjadi sumber utama dan perubahan tidak memerlukan restart worker.
TRACKING_WEBHOOK_ENABLED=false
EMISELL_TRACKING_WEBHOOK_URL=https://api.emisell.com/api/webhooks/api-kurir/tracking
EMISELL_TRACKING_WEBHOOK_SECRET=
TRACKING_WEBHOOK_TIMEOUT=5s
TRACKING_WEBHOOK_CONCURRENCY=4
TRACKING_WEBHOOK_POLL_INTERVAL=1s
