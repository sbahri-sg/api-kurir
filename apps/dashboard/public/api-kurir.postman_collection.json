        {
          "name": "List Provider Keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/admin/provider-credentials",
              "host": ["{{base_url}}"],
              "path": ["v1", "admin", "provider-credentials"]
            },
            "description": "Membaca metadata key provider yang sudah dimasking. Secret dan ciphertext tidak pernah dikembalikan."
          },
          "response": []
        },
        {
          "name": "Add RajaOngkir Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Provider key berhasil divalidasi dan disimpan', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const payload = pm.response.json();",
                  "if (payload.data && payload.data.id) {",
                  "  pm.environment.set('provider_credential_id', payload.data.id);",
                  "}",
                  "console.warn('Hapus Current Value rajaongkir_api_key dari Postman setelah request berhasil.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Admin-Actor",
                "value": "postman"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider_code\": \"rajaongkir\",\n  \"api_key\": \"{{rajaongkir_api_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/admin/provider-credentials",
              "host": ["{{base_url}}"],
              "path": ["v1", "admin", "provider-credentials"]
            },
            "description": "Key diuji langsung ke RajaOngkir, dienkripsi AES-256-GCM, dan langsung masuk rotasi runtime. Validasi memakai satu hit provider."
          },
          "response": []
        },
        {
          "name": "Disable Provider Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Actor",
                "value": "postman"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/admin/provider-credentials/{{provider_credential_id}}/disable",
              "host": ["{{base_url}}"],
              "path": [
                "v1",
                "admin",
                "provider-credentials",
                "{{provider_credential_id}}",
                "disable"
              ]
            },
            "description": "Menonaktifkan satu key agar tidak lagi dipilih untuk cek tarif atau tracking."
          },
          "response": []
        },
        {
          "name": "List Customer API Keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/admin/api-keys?limit=100&offset=0",
              "host": ["{{base_url}}"],
              "path": ["v1", "admin", "api-keys"],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Hanya metadata key yang dikembalikan; secret dan hash tidak pernah masuk response daftar."
          },
          "response": []
        },
        {
          "name": "Generate Customer API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API key berhasil dibuat', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const payload = pm.response.json();",
                  "if (payload.data && payload.data.api_key) {",
                  "  pm.environment.set('customer_api_key_id', payload.data.api_key.id);",
                  "}",
                  "console.warn('Simpan secret dari response sekarang. Secret tidak disimpan otomatis ke environment.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Actor",
                "value": "postman"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/admin/api-keys",
              "host": ["{{base_url}}"],
              "path": ["v1", "admin", "api-keys"]
            },
            "description": "Tidak memerlukan body. Key dibuat tanpa nama dan tanpa masa berlaku. Secret lengkap hanya tampil pada response ini dan tidak disimpan otomatis."
          },
          "response": []
        },
        {
          "name": "Revoke Customer API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Actor",
                "value": "postman"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/admin/api-keys/{{customer_api_key_id}}/revoke",
              "host": ["{{base_url}}"],
              "path": [
                "v1",
                "admin",
                "api-keys",
                "{{customer_api_key_id}}",
                "revoke"
              ]
            },
            "description": "Mencabut key customer yang ID-nya tersimpan setelah request generate."
          },
          "response": []
        }
