APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://api_kurir:api_kurir@localhost:55432/api_kurir?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
API_KEYS=dev-api-key
ADMIN_API_KEYS=dev-emisell
SHUTDOWN_TIMEOUT=10s

# Redis disiapkan, tetapi tidak wajib pada fase MVP.
REDIS_ENABLED=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=api-kurir

# Key RajaOngkir ditambahkan dari Dashboard > Kuota provider.
# Master key ini mengenkripsi seluruh credential provider di database.
# Production wajib mengisinya dengan base64 acak yang decode menjadi 32 byte.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

# Konteks merchant Emisell ditandatangani Ed25519 oleh api-service.
# Isi dengan public key Ed25519 base64 (32 byte); private key hanya di Emisell.
TENANT_CONTEXT_PUBLIC_KEY=
TENANT_CONTEXT_ISSUER=emisell-api
TENANT_CONTEXT_AUDIENCE=api-kurir
TENANT_CONTEXT_MAX_TTL=5m

# RAJAONGKIR_API_KEY hanya fallback legacy; biarkan kosong untuk instalasi baru.
RAJAONGKIR_TRACKING_COURIERS=jne,sap,ninja,jnt,tiki,wahana,pos,lion,anteraja
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1/
RAJAONGKIR_TIMEOUT=4s
RAJAONGKIR_DAILY_LIMIT=50000
RAJAONGKIR_CREDENTIAL_ALIAS=primary
RAJAONGKIR_SNAPSHOT_TTL=336h
RAJAONGKIR_MIN_REQUEST_INTERVAL=250ms
LOCATION_SYNC_REQUEST_INTERVAL=250ms

# Biteship hanya dipakai sebagai fallback tracking untuk kurir yang tidak
# tersedia di RajaOngkir. Token disimpan melalui Dashboard > Kuota provider,
# bukan di environment. Kurir instant (Grab/GoSend) sengaja tidak diikutkan.
BITESHIP_BASE_URL=https://api.biteship.com/
BITESHIP_TIMEOUT=5s
BITESHIP_TRACKING_COURIERS=ide,rpx,sentral,sicepat

# Tracking menyimpan resi terenkripsi. Key wajib base64 yang decode menjadi 32 byte.
TRACKING_ENABLED=false
TRACKING_ENCRYPTION_KEY=
TRACKING_WORKER_ID=worker-local
TRACKING_WORKER_CONCURRENCY=8
TRACKING_POLL_INTERVAL=1s

# Webhook hanya menuju backend Emisell yang dikonfigurasi operator. URL callback
# tidak pernah diterima dari request seller untuk mencegah SSRF.
# Fallback migrasi. Setelah diatur dari menu Developer > Webhook, konfigurasi
# database menjadi sumber utama dan perubahan tidak memerlukan restart worker.
TRACKING_WEBHOOK_ENABLED=false
EMISELL_TRACKING_WEBHOOK_URL=https://api.emisell.com/api/webhooks/api-kurir/tracking
EMISELL_TRACKING_WEBHOOK_SECRET=
TRACKING_WEBHOOK_TIMEOUT=5s
TRACKING_WEBHOOK_CONCURRENCY=4
TRACKING_WEBHOOK_POLL_INTERVAL=1s
