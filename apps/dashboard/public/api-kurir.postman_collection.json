{
  "info": {
    "_postman_id": "4b8ac7bb-fbd1-4b02-9c39-45a9c368cc71",
    "name": "API Kurir · Emisell",
    "description": "Collection resmi untuk API Kurir. Workflow pencarian origin dan destination otomatis menyimpan ID lokasi ke environment sebelum cek ongkir.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/live",
              "host": ["{{base_url}}"],
              "path": ["health", "live"]
            },
            "description": "Memastikan proses API sedang berjalan."
          },
          "response": []
        },
        {
          "name": "Readiness",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/ready",
              "host": ["{{base_url}}"],
              "path": ["health", "ready"]
            },
            "description": "Memastikan API dan PostgreSQL siap menerima traffic."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Locations",
      "description": "Jalankan dua request ini terlebih dahulu. Test script otomatis menyimpan origin_id dan destination_id ke environment.",
      "item": [
        {
          "name": "Search Origin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const payload = pm.response.json();",
                  "if (payload.data && payload.data[0]) {",
                  "  pm.environment.set('origin_id', payload.data[0].id);",
                  "  console.log('origin_id tersimpan:', payload.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/destination/domestic-destination?search={{origin_search}}&limit=20",
              "host": ["{{base_url}}"],
              "path": ["v1", "destination", "domestic-destination"],
              "query": [
                {
                  "key": "search",
                  "value": "{{origin_search}}"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Mencari origin dan menyimpan ID hasil pertama ke origin_id."
          },
          "response": []
        },
        {
          "name": "Search Destination",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const payload = pm.response.json();",
                  "if (payload.data && payload.data[0]) {",
                  "  pm.environment.set('destination_id', payload.data[0].id);",
                  "  console.log('destination_id tersimpan:', payload.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/destination/domestic-destination?search={{destination_search}}&limit=20",
              "host": ["{{base_url}}"],
              "path": ["v1", "destination", "domestic-destination"],
              "query": [
                {
                  "key": "search",
                  "value": "{{destination_search}}"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Mencari destination dan menyimpan ID hasil pertama ke destination_id."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Shipping Cost",
      "item": [
        {
          "name": "List Couriers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/couriers",
              "host": ["{{base_url}}"],
              "path": ["v1", "couriers"]
            },
            "description": "Membaca kurir dan layanan aktif."
          },
          "response": []
        },
        {
          "name": "Calculate Domestic Cost",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response berhasil atau tarif belum tersedia', function () {",
                  "  pm.expect([200, 422]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "postman-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": \"{{origin_id}}\",\n  \"destination\": \"{{destination_id}}\",\n  \"weight\": {{weight_grams}},\n  \"courier\": \"{{courier}}\",\n  \"dimensions\": {\n    \"length\": 30,\n    \"width\": 20,\n    \"height\": 15,\n    \"unit\": \"cm\"\n  },\n  \"item_value\": 250000,\n  \"options\": {\n    \"include_insurance\": false,\n    \"include_unverified\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/calculate/domestic-cost",
              "host": ["{{base_url}}"],
              "path": ["v1", "calculate", "domestic-cost"]
            },
            "description": "Cek ongkir dengan ID lokasi yang otomatis diisi oleh request pencarian."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Tracking",
      "item": [
        {
          "name": "Track Waybill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"waybill\": \"{{waybill}}\",\n  \"courier\": \"{{courier}}\",\n  \"refresh\": \"if_stale\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/track/waybill",
              "host": ["{{base_url}}"],
              "path": ["v1", "track", "waybill"]
            },
            "description": "Cek resi cukup menggunakan nomor resi dan kode ekspedisi."
          },
          "response": []
        }
      ]
    },
